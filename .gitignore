# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
.env

# Node.js & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editor Configs
.idea/
.vscode/
*.swp
*.swo
*~
.history/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs & Diagnostics
*.log
*.tmp
temp/
scratch/

# User Profile Audio Recordings (Do not track personal noise recordings)
# Keep directory structures with .gitkeep
backend/data/user_profiles/*/claps/*.wav
backend/data/user_profiles/*/typing/*.wav
backend/data/user_profiles/*/speech/*.wav
backend/data/user_profiles/*/snaps/*.wav
backend/data/user_profiles/*/ambient/*.wav
backend/data/user_profiles/*/noises/*.wav
