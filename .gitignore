# ==============================================================================
#  HandClap Detection & Smart Light - Git Ignore Configuration
# ==============================================================================

# Python & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
venv/
ENV/
env/
.env

# Node.js & Frontend Build Artifacts
node_modules/
frontend/node_modules/
frontend/dist/
frontend/.vite/
.npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# IDE & Editor Configs
.idea/
.vscode/
.agent/
*.swp
*.swo
*~
.history/

# Operating System Files
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Logs & Diagnostics
*.log
*.tmp
temp/
scratch/

# ==============================================================================
#  RAW AUDIO TRAINING DATA (DO NOT COMMIT RAW SAMPLES)
# ==============================================================================
*.wav
*.npy
*.npz
*.mp3
*.flac
*.ogg
*.raw
backend/data/user_profiles/
backend/data/default_samples/

# ==============================================================================
#  AI MODEL CHECKPOINTS (TRACKED SO SERVERS CAN PULL TRAINED BRAIN)
# ==============================================================================
!backend/data/checkpoints/
!backend/data/checkpoints/**
