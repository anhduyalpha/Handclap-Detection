{
  "server_hostname": "linux-audio-server",
  "os": "Ubuntu 24.04 LTS",
  "cpu": {
    "architecture": "x86_64",
    "recommended_threads": 4
  },
  "audio_hardware": {
    "recommended_driver": "ALSA Analog",
    "sample_rate": 16000,
    "channels": 1
  },
  "runtime_environment": {
    "python_version": "3.10+",
    "node_version": "v18+"
  },
  "network": {
    "default_backend_port": 8000,
    "default_frontend_port": 5173
  }
}
