# ==============================================================================
#  HandClap Detection & Smart Light Platform - Environment Configuration
# ==============================================================================

# Network URLs for Multi-Node Synchronization
WINDOWS_STUDIO_URL=http://127.0.0.1:8001
LINUX_SERVER_URL=http://127.0.0.1:8000

# Home Assistant / ESP32 External Webhook URL (Optional)
WEBHOOK_URL=http://127.0.0.1:8123/api/webhook/clap_trigger

# Active Learning: Auto-forward high-confidence claps from Linux to Windows
AUTO_COLLECT_TRUE_CLAPS=true

# Security: Shared Secret Token for Inter-Node Checkpoint Sync
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
STUDIO_API_TOKEN=

# CORS Allowed Origins (Comma-separated list or * for local dev)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174
